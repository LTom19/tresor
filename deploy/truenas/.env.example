# Copiez ce fichier en .env sur le NAS (NE PAS commiter .env)
# Chemin suggéré : /mnt/pool/apps/tresor/.env

DATABASE_URL=postgresql://tresor:VOTRE_MOT_DE_PASSE@127.0.0.1:5432/db_tresor
JWT_SECRET=generez-une-cle-longue-avec-openssl-rand-base64-48
CORS_ORIGIN=https://votre-domaine.example
NODE_ENV=production
PORT=1010
TZ=Europe/Paris
AUTO_PAYMENT_INTERVAL_MS=900000
# Inscriptions ouvertes par défaut. Mettez true pour les fermer.
DISABLE_REGISTRATION=false
