# PostgreSQL
DATABASE_URL=postgresql://utilisateur:MOT_DE_PASSE@127.0.0.1:5432/database

# Sécurité
JWT_SECRET=generez-avec-openssl-rand-base64-48
# Inscriptions ouvertes par défaut. Mettez true pour les fermer.
DISABLE_REGISTRATION=false

# Production
NODE_ENV=production
PORT=1010
TZ=Europe/Paris
CORS_ORIGIN=https://votre-domaine.example
AUTO_PAYMENT_INTERVAL_MS=900000

# Frontend (build nginx)
VITE_API_URL=/api
